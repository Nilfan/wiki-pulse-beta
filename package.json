{
  "name": "wiki-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "APP_ROLE=backend next dev",
    "seed:local": "tsx prisma/seed-local.ts",
    "build": "prisma generate && next build",
    "build:prod": "NODE_ENV=production pnpm build",
    "start": "next start",
    "lint": "eslint",
    "start:data-collector": "deno run --env-file -R -E --allow-net --sloppy-imports --allow-sys data-collector/index.ts",
    "build:data-collector": "cd data-collector && deno install && cd ../",
    "build:frontend": "prisma generate && APP_ROLE=frontend next build",
    "build:backend": "prisma generate && prisma migrate deploy && APP_ROLE=backend next build",
    "start:frontend": "next start",
    "start:backend": "APP_ROLE=backend next start",
    "prisma:studio:local": "npx prisma studio --url=\"postgresql://postgres:postgres@127.0.0.1:5432/nextjs_dev\"",
    "start:assistant": "APP_ROLE=backend tsx server/assistant/index.ts",
    "start:assistant:prod": "APP_ROLE=backend NODE_ENV=production tsx server/assistant/index.ts",
    "dev:assistant": "APP_ROLE=backend NODE_ENV=development tsx watch server/assistant/index.ts",
    "test:assistant": "tsx --test server/assistant/config.test.ts server/assistant/service.test.ts server/assistant/ollama.test.ts server/assistant/tools.test.ts server/assistant/analytics.test.ts lib/assistant/websocket-transport.test.ts lib/assistant/markdown.test.tsx",
    "run:ollama:local": "OLLAMA_HOST=127.0.0.1:11434 ollama serve"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.160",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tabler/icons-react": "^3.44.0",
    "ai": "^7.0.156",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "next": "16.4.1",
    "ollama-ai-provider-v2": "^4.1.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.22.4",
    "valibot": "^1.4.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@recharts/devtools": "^0.0.18",
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
